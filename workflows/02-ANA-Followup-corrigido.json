        "query": "WITH u AS (UPDATE ana_leads SET followup_due_at=NULL,updated_at=now() WHERE phone=($1::jsonb->>'phone') AND last_patient_msg_at IS NOT DISTINCT FROM NULLIF($1::jsonb->'payload'->>'patient_snapshot','')::timestamptz RETURNING phone) SELECT count(*)::int AS suspended FROM u;",
        "options": {
