        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ [JSON.stringify(({...$('Montar Follow-up').item.json,origin:'ANA-02',texto:$('Montar Follow-up').item.json.mensagem,send_key:'ANA-02:'+String($env.EVOLUTION_INSTANCE)+':'+$('Montar Follow-up').item.json.phone+':'+String($('Um Lead por Vez').item.json.last_patient_msg_at||'sem-contato')+':'+$('Montar Follow-up').item.json.step,patient_snapshot:$('Um Lead por Vez').item.json.last_patient_msg_at||null,dados:JSON.parse($('Montar Follow-up').item.json.pg_msg).dados,owner:String($execution.id)}))] }}"
