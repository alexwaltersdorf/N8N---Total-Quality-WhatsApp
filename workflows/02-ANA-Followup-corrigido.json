        272
      ],
      "id": "a01dd6ff-391f-472c-af1f-2f50021247ed"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH p AS (SELECT $1::jsonb j),u AS (UPDATE ana_leads l SET followup_due_at=NULLIF(p.j->>'followup_due','')::timestamptz,proxima_acao=p.j->>'proxima_acao',updated_at=now() FROM p WHERE l.phone=p.j->>'phone' AND l.bot_ativo=true AND l.opt_out IS NOT TRUE AND l.last_patient_msg_at IS NOT DISTINCT FROM NULLIF(p.j->>'patient_snapshot','')::timestamptz AND NOT EXISTS(SELECT 1 FROM ana_runtime_observed o WHERE o.phone=l.phone AND o.state='pending') RETURNING l.phone) SELECT count(*)::int AS applied FROM u;",
        "options": {
          "queryReplacement": "={{ [JSON.stringify({...JSON.parse($('Montar Follow-up').item.json.pg_lead),patient_snapshot:$('Um Lead por Vez').item.json.last_patient_msg_at||null})] }}"
        }
      },
      "name": "Atualizar Lead FU",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1344,
        272
      ],
      "id": "670b054d-f19e-4300-9889-63ec6cc7d698"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_APIKEY }}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.guard.payload.phone, text: $json.guard.payload.texto, delay: 0, linkPreview: false }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "name": "Enviar Follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1520,
        272
      ],
      "id": "e0b73a91-cbb2-43ed-b4df-8a2dc4b7797a",
      "onError": "continueRegularOutput",
      "retryOnFail": false
    },
    {
      "parameters": {
        "jsCode": "const lead  = $input.first().json;\nconst phone = lead.phone;\nconst step  = Number(lead.followup_step) || 1;\n\nfunction primeiroNome(n) {\n  const p = String(n || '').trim().split(/\\s+/)[0] || '';\n  if (p.length < 2 || !/^[A-Za-zÀ-ÿ]+$/.test(p)) return '';\n  return p.charAt(0).toUpperCase() + p.slice(1).toLowerCase();\n}\nconst nome = primeiroNome(lead.nome);\n\nconst lista = String(lead.exames_txt || '').split('; ').map(s => s.trim()).filter(Boolean);\nconst exame = lista.length === 1 ? lista[0]\n            : lista.length === 2 ? (lista[0] + ' e ' + lista[1])\n            : '';\n\nconst oi      = nome ? ('Oi, ' + nome) : 'Oi';\nconst orcDo   = exame ? ('o orçamento de *' + exame + '*') : 'o orçamento que te passei';\nconst oExame  = exame ? ('*' + exame + '*') : 'o exame';\nconst sobreEx = exame ? ('sobre *' + exame + '*') : 'sobre o seu exame';\nconst coleta  = lead.tem_lab === true\n  ? '\\n- Para exames de laboratório, também fazemos *coleta domiciliar*' : '';\n\n// Cadência V1 (2026-10-17): FU1 ~3h após orçamento/pergunta, FU2 no dia seguinte, FU3 encerra com porta aberta.\nconst textos = {\n1: oi + '! Ficou alguma dúvida sobre ' + orcDo + '?',\n2: oi + '! Se ainda quiser fazer ' + oExame + ', qual dia ou período funciona melhor para você? Encaminho a preferência à equipe.' + coleta + '\\n\\nSe preferir não receber lembretes, responda *parar*.',\n3: oi + '. Como não tive seu retorno, vou encerrar os lembretes ' + sobreEx + '. Quando for um bom momento, é só escrever por aqui. A equipe da Total Quality fica à disposição.'\n};\n\nconst mensagem = textos[step];\nif (!mensagem) return [{ json: { skip: true, phone } }];\n\nconst gaps = { 1: 1, 2: 2, 3: null };\nconst due = gaps[step] ? new Date(Date.now() + gaps[step] * 86400000).toISOString() : null;\n\nreturn [{ json: {\n  phone, mensagem, step,\n  pg_msg: JSON.stringify({ phone, conteudo: mensagem,\n    dados: { evento: 'follow_up', passo: step, origem: 'ANA-02', modelo: 'texto fixo' } }),\n  pg_lead: JSON.stringify({ phone, step, followup_due: due,\n    proxima_acao: step === 3 ? 'encerrar' : 'follow_up_d1' }),\n} }];"
      },
      "id": "b9d692ee-9786-4c77-b8f9-06110e918a32",
      "name": "Montar Follow-up",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
