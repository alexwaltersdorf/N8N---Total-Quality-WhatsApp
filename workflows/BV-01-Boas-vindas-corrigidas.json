    {
      "parameters": {
        "jsCode": "const JANELA_HORAS = 14;\nconst MAX_POR_RODADA = 10;\nconst HORA_INICIO = 8;\nconst HORA_FIM = 20;\n\nconst IDENTIFICACAO = 'Total Quality Medicina Diagnóstica — Registro 970616\\nResponsável Técnico: Alex Waltersdorf - 267.339';\n\nfunction montarMensagem(primeiroNome) {\n const nome=/^[A-Za-zÀ-ÿ]{2,30}$/.test(primeiroNome||'')?primeiroNome:'';\n return (nome?'Olá, '+nome+'!':'Olá!')+' Sou a Ana, assistente virtual da Total Quality. Recebemos seu contato pelo site. Com qual exame ou dúvida podemos ajudar?\\n\\n'+IDENTIFICACAO;\n}\n\nconst NOMES_BLOQUEADOS = /teste|ignorar/i;\nconst NUMEROS_BLOQUEADOS = new Set(['5512999990000']);\n\nfunction normalizarTelefone(bruto) {\n  const d = String(bruto == null ? '' : bruto).replace(/\\D/g, '');\n  let nacional = d;\n  if (d.length === 12 || d.length === 13) {\n    if (d.slice(0, 2) !== '55') return null;\n    nacional = d.slice(2);\n  } else if (d.length !== 10 && d.length !== 11) {\n    return null;\n  }\n  if (nacional.length !== 11) return null;\n  if (nacional.charAt(2) !== '9') return null;\n  const ddd = Number(nacional.slice(0, 2));\n  if (ddd < 11 || ddd > 99) return null;\n  return '55' + nacional;\n}\n\nfunction instanteDaLinha(texto) {\n  const m = String(texto == null ? '' : texto).match(/^(\\d{2})\\/(\\d{2})\\/(\\d{4})[ T](\\d{2}):(\\d{2}):(\\d{2})$/);\n  if (!m) return null;\n  return Date.UTC(Number(m[3]), Number(m[2]) - 1, Number(m[1]), Number(m[4]) + 3, Number(m[5]), Number(m[6]));\n}\n\nconst agora = Date.now();\nconst limite = agora - JANELA_HORAS * 60 * 60 * 1000;\nconst horaLocal = Number(new Date(agora).toLocaleString('en-US', { timeZone: 'America/Sao_Paulo', hour: '2-digit', hour12: false }));\nconst horarioPermitido = horaLocal >= HORA_INICIO && horaLocal < HORA_FIM;\n\nconst vistos = new Set();\nconst saida = [];\n\nfor (const item of $input.all()) {\n  const linha = item.json;\n  if(linha.opt_out===true || /^(true|sim|1)$/i.test(String(linha['Opt-out']||'')))continue;\n  const quando = instanteDaLinha(linha['Data/Hora']);\n  if (quando === null || quando < limite || quando > agora + 60 * 60 * 1000) continue;\n\n  const nomeBruto = String(linha['Nome'] == null ? '' : linha['Nome']).trim();\n  if (NOMES_BLOQUEADOS.test(nomeBruto)) continue;\n\n  const telefone = normalizarTelefone(linha['Telefone']);\n  if (!telefone) continue;\n  if (NUMEROS_BLOQUEADOS.has(telefone)) continue;\n\n  if (vistos.has(telefone)) continue;\n  vistos.add(telefone);\n\n  const primeiroNome = nomeBruto ? nomeBruto.split(/\\s+/)[0] : '';\n  saida.push({ json: {\n    telefone: telefone,\n    nome: nomeBruto,\n    origem: String(linha['Origem (source)'] == null ? '' : linha['Origem (source)']),\n    texto: montarMensagem(primeiroNome),\n    delay: 1200,\n    horarioPermitido: horarioPermitido\n  } });\n}\n\nreturn [{json:{candidates:saida.map(x=>x.json)}}];"
      },
