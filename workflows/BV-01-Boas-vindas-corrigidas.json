      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT v AS candidate FROM jsonb_array_elements($1::jsonb->'candidates') WITH ORDINALITY AS e(v,ord) WHERE (v->>'horarioPermitido')::boolean=true AND NOT EXISTS(SELECT 1 FROM tq_boasvindas_enviadas t WHERE t.telefone=v->>'telefone') AND NOT EXISTS(SELECT 1 FROM ana_runtime_outbox o WHERE o.phone=v->>'telefone' AND o.origin='BV-01') AND NOT EXISTS(SELECT 1 FROM ana_leads l WHERE l.phone=v->>'telefone' AND (l.bot_ativo IS NOT TRUE OR l.opt_out=true OR l.last_patient_msg_at IS NOT NULL)) AND NOT EXISTS(SELECT 1 FROM ana_mensagens m WHERE m.phone=v->>'telefone') ORDER BY ord LIMIT 10;",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ [JSON.stringify($json)] }}"
        }
      },
